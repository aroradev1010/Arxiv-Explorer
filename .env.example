APP_ENV=development
HOST=127.0.0.1
PORT=8000
DATASET_DIR=data/processed
INDEX_DIR=data/indexes
MODEL_DIR=data/models/all-MiniLM-L6-v2
METADATA_DB=var/metadata.sqlite
DEFAULT_SEARCH_MODE=hybrid
DEFAULT_RESULT_LIMIT=10
MAX_RESULT_LIMIT=100
MAX_RANKING_WINDOW=1000
RRF_K=60
RRF_CANDIDATE_DEPTH=200
WORKER_THREADS=2
COMPUTE_THREADS=2
QUEUE_TIMEOUT_SECONDS=1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
EVALUATION_ENABLED=true
EVALUATION_DB_PATH=var/evaluation.sqlite
# Enable only on a trusted localhost development server; production refuses writes.
EVALUATION_MUTATIONS_ENABLED=false
